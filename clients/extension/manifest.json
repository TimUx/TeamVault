{
  "action": {
    "default_popup": "popup.html",
    "default_title": "TeamVault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "teamvault@local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "Zero-Knowledge vault client — decrypts only in the browser extension.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "key": "",
  "manifest_version": 3,
  "name": "TeamVault",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "version": "0.10.0"
}
