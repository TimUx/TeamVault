# TeamVault — Compose / local env template
# Copy to `.env` (gitignored). Do NOT put the unlock key bytes here —
# only the path to a keyfile (≥32 random bytes).
#
#   cp .env.example .env
#   mkdir -p secrets && openssl rand -out secrets/teamvault_unlock 48
#   docker compose pull && docker compose up -d

# Host port published by Docker Compose
TEAMVAULT_PUBLISH_PORT=8080

# Unlock keyfile on the host (mounted read-only into the container)
TEAMVAULT_UNLOCK_KEY_HOST=./secrets/teamvault_unlock

# Container image from GitHub Actions → GHCR (default). Examples:
#   ghcr.io/timux/teamvault:latest
#   ghcr.io/timux/teamvault:1.1.1
# Local build only: teamvault:local + docker-compose.build.yml
TEAMVAULT_IMAGE=ghcr.io/timux/teamvault:latest

# pull_policy for Compose (always | missing | never). Default always keeps CI images fresh.
TEAMVAULT_PULL_POLICY=always

# --- Go / local process (source this file: `set -a; source .env; set +a`) ---
TEAMVAULT_ADDR=:8080
TEAMVAULT_DATA_DIR=./data
TEAMVAULT_MASTER_UNLOCK_KEY_FILE=./secrets/teamvault_unlock
